# Copy this file to .env.local and fill in your values

# Claude AI — for AI-powered notice generation
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend — for email delivery feature
# Get your key at: https://resend.com
RESEND_API_KEY=

# Your domain (used for OG metadata and email from address)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Email from address (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@your-domain.com
